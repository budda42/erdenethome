# Copy to .env.local (local) or set in Vercel → Project → Environment Variables.
# Either DATABASE_URL, or the DB_* group:
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/erdenet_home
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=eh
# DB_PASSWORD=...
# DB_NAME=erdenet_home

# At least 32 random characters. Generate: openssl rand -base64 48
AUTH_SECRET=

# Optional: local folder for uploads (default ./uploads)
# UPLOAD_DIR=

# Optional: forward customer chat messages to Make/Zapier (→ Facebook Page/Messenger). Leave empty to disable.
CHAT_FORWARD_WEBHOOK_URL=

# Optional: "true" publishes customer ads (from /my/listings) immediately, so they show on /map
# for everyone right away. Default: ads wait for admin approval (the owner still sees theirs on the map).
LISTINGS_AUTO_PUBLISH=
